<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="group4_custom">

    <physics name="default_physics" type="ode">
        <max_step_size>0.005</max_step_size>
        <real_time_factor>1.0</real_time_factor>
        <real_time_update_rate>200</real_time_update_rate>
    </physics>

    <!-- Core Ignition systems (Fortress / Gazebo6) -->
    <plugin filename="libignition-gazebo6-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="libignition-gazebo6-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="libignition-gazebo6-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="libignition-gazebo6-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Scene configuration -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- Sun light -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Gazebo Fortress GUI -->
    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>0.7 0 4.2 0 1.5708 0</camera_pose>
      </plugin>

      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">1</property>
          <property key="height" type="double">1</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">1</property>
          <property key="height" type="double">1</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">1</property>
          <property key="height" type="double">1</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="width" type="double">1</property>
          <property key="height" type="double">1</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>

      <plugin filename="ComponentInspector" name="Component inspector"/>
      <plugin filename="EntityTree" name="Entity tree"/>
    </gui>

    <!-- ================================================================== -->
    <!-- Outer Boundary (3.6 m x 3.6 m: x in [-1.1, 2.5], y in [-1.8, 1.8]) -->
    <!-- ================================================================== -->

    <!-- North wall (x = 2.5) -->
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_north_1</name>
      <pose>2.5 1.2 0.15 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_north_2</name>
      <pose>2.5 0.0 0.15 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_north_3</name>
      <pose>2.5 -1.2 0.15 0 0 1.5708</pose>
    </include>

    <!-- South wall (x = -1.1) -->
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_south_1</name>
      <pose>-1.1 1.2 0.15 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_south_2</name>
      <pose>-1.1 0.0 0.15 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_south_3</name>
      <pose>-1.1 -1.2 0.15 0 0 1.5708</pose>
    </include>

    <!-- West / Left wall (y = 1.8) -->
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_west_1</name>
      <pose>1.9 1.8 0.15 0 0 0</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_west_2</name>
      <pose>0.7 1.8 0.15 0 0 0</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_west_3</name>
      <pose>-0.5 1.8 0.15 0 0 0</pose>
    </include>

    <!-- East / Right wall (y = -1.8) -->
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_east_1</name>
      <pose>1.9 -1.8 0.15 0 0 0</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_east_2</name>
      <pose>0.7 -1.8 0.15 0 0 0</pose>
    </include>
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_east_3</name>
      <pose>-0.5 -1.8 0.15 0 0 0</pose>
    </include>

    <!-- ================================================================== -->
    <!-- Internal Walls forming a "4" (1.70 m x 1.50 m) with wide corridors -->
    <!-- Clear corridor widths:                                             -->
    <!--   West: 1.025 m | East: 1.025 m | South: 0.975 m | North: 0.875 m  -->
    <!--   Upper bay inside the "4": 1.10 m wide                            -->
    <!-- (Top-down view: +X is Up, +Y is Left, -Y is Right)                 -->
    <!-- ================================================================== -->

    <!-- Horizontal crossbar of the "4" (x = 0.80, y from +0.75 to -0.75) -->
    <include>
      <uri>model://wall120cm</uri>
      <name>wall120_four_cross_left</name>
      <pose>0.80 0.15 0.15 0 0 1.5708</pose>
    </include>
    <include>
      <uri>model://wall30cm</uri>
      <name>wall30_four_cross_right</name>
      <pose>0.80 -0.60 0.15 0 0 1.5708</pose>
    </include>

    <!-- Upper-left vertical arm of the "4" (y = +0.725, x from 0.775 to 1.675, flush with crossbar) -->
    <include>
      <uri>model://wall90cm</uri>
      <name>wall90_four_left_arm</name>
      <pose>1.225 0.725 0.15 0 0 0</pose>
    </include>

    <!-- Right vertical stem of the "4" (y = -0.425, x from -0.125 to 1.675) -->
    <include>
      <uri>model://wall90cm</uri>
      <name>wall90_four_stem_top</name>
      <pose>1.225 -0.425 0.15 0 0 0</pose>
    </include>
    <include>
      <uri>model://wall90cm</uri>
      <name>wall90_four_stem_bottom</name>
      <pose>0.325 -0.425 0.15 0 0 0</pose>
    </include>

    <!-- Traffic sign for perception activities (against crossbar, facing robot) -->
    <include>
      <uri>model://sign_right_ign</uri>
      <name>sign_right_1</name>
      <pose>0.65 0.15 0 0 0 1.5708</pose>
    </include>

  </world>
</sdf>
